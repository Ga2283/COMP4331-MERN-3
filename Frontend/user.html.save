<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyCollection - Dashboard</title>
    <link rel="stylesheet" href="css/user_style.css">
</head>
<body>
    <div class="app-container">
        <!-- Top Navigation -->
        <header class="navbar">
            <div class="logo">
                <span class="logo-icon">📦</span>
                <span class="logo-text">MyCollection</span>
            </div>
            <div class="user-nav-right" style="display: flex; align-items: center; gap: 15px;">
                <div class="user-profile">
                    <span class="username" id="userGreeting">Loading...</span>
                </div>
                <button id="logoutBtn" class="btn-secondary" style="padding: 6px 12px; font-size: 14px; cursor: pointer;">Log Out</button>
            </div>
        </header>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Search & Filter Controls -->
            <section class="controls-section">
                <div class="search-bar">
                    <span class="search-icon">🔍</span>
                    <input type="text" id="searchInput" placeholder="Search your collection...">
                </div>
                
                <div class="filter-tabs">
                    <button class="filter-btn active" data-category="All">All</button>
                    <button class="filter-btn" data-category="Cards">Cards</button>
                    <button class="filter-btn" data-category="Comic books">Comic books</button>
                    <button class="filter-btn" data-category="Figurines">Figurines</button>
                    <button class="filter-btn" data-category="Misc.">Misc.</button>
                </div>

                <button class="add-btn" id="openAddModalBtn">+ Add to your collection</button>
            </section>

            <!-- Collection Grid Container -->
            <section class="grid-section">
                <div class="grid-container" id="collectionGrid">
                    <!-- Dynamic collection cards rendered via user_script.js -->
                </div>
            </section>

            <!-- Pagination Control -->
            <section class="pagination-section" id="paginationSection">
                <button class="arrow-down-btn" id="nextPageBtn" title="Load Next Page">
                    <span>▼</span>
                    <span class="btn-text">Load Next 12 Items</span>
                </button>
                <div class="pagination-info" id="paginationInfo">Showing 0 of 0</div>
            </section>
        </main>
    </div>

    <!-- Add Item Modal -->
    <div class="modal-overlay" id="addModal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Add New Item</h3>
                <button class="close-btn" id="closeAddModalBtn">&times;</button>
            </div>
            <form id="addItemForm">
                <div class="form-group">
                    <label for="itemName">Item Name</label>
                    <input type="text" id="itemName" required placeholder="e.g. Charizard 1st Edition">
                </div>
                <div class="form-group">
                    <label for="itemCategory">Category</label>
                    <select id="itemCategory" required>
                        <option value="Cards">Cards</option>
                        <option value="Comic books">Comic books</option>
                        <option value="Figurines">Figurines</option>
                        <option value="Misc.">Misc.</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="itemDescription">Description</label>
                    <textarea id="itemDescription" rows="3" placeholder="Mint condition, graded PSA 9..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="itemImageUrl">Image URL</label>
                    <input type="url" id="itemImageUrl" placeholder="https://example.com/image.jpg">
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-secondary" id="cancelModalBtn">Cancel</button>
                    <button type="submit" class="btn-primary">Save Item</button>
                </div>
            </form>
        </div>
    </div>


    <script src="user_script.js"></script>
</body>
</html>
